# Copy to api/.env or export these before running the API.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/reviewdesk
JWT_SECRET=replace-with-a-long-random-string-at-least-16-chars
PORT=4000
# Optional
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# CORS_ORIGIN=http://localhost:5173
# METRICS_TOKEN=some-secret     # if set, /metrics requires "Authorization: Bearer <token>"
# LOG_LEVEL=info
# WEB_DIST=../web/dist          # serve the built React app from the API
